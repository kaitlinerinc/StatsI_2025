y <- c(105, 69, 86, 100, 82, 111, 104, 110, 87, 108, 87, 90, 94, 113, 112, 98, 80, 97, 95, 111, 114, 89, 95, 126, 98)
# Steps to make a confidence interval for y
#Step 1: Calculate the sample mean. The sample mean equals the sum of the values divided by the number of values.
n <- length(y)
mean_y <- sum(y)/n
mean_y
#Step 2: Calculate the standard deviation. Standard deviation = the distance of the y values from the mean.
distance_from_mean <- y - mean_y
distance_from_mean_squared <- distance_from_mean^2
absolute_distance_from_mean <- sqrt(distance_from_mean_squared)
standard_deviation_y <- sum(absolute_distance_from_mean)/(n-1)
