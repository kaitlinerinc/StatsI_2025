# read in data
inc.sub <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsI_2025/main/datasets/incumbents_subset.csv")
View(inc.sub)
?lm
#Question 1
lm(data = inc.sub, presvote ~ difflog)
lm(inc.sub$presvote ~ inc.sub ~ difflog)
lm(inc.sub$presvote ~ inc.sub$difflog)
#Question 1
lm(data = inc.sub, presvote ~ difflog)
?lm
lm(inc.sub$presvote ~ inc.sub$difflog)
lm(presvote ~ difflog, data = inc.sub)
#Question 1
lm(presvote ~ difflog, inc.sub)
#Question 1
lm(presvote ~ difflog, inc.sub)
plot(difflog, presvote)
